{
  "name": "icare-crm",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild firebase-crm.mjs --bundle --format=esm --platform=browser --outfile=firebase-crm.js",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test --test-concurrency=1 test.mjs firebase-sync.test.mjs webp-upload.test.mjs pages.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
