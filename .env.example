# Copy to .env for local Node or .dev.vars for Wrangler Pages development.
# In Cloudflare set these as runtime variables/secrets. Do not commit actual values.
FIREBASE_API_KEY=replace_with_web_api_key
FIREBASE_AUTH_DOMAIN=replace_with_auth_domain
FIREBASE_PROJECT_ID=replace_with_project_id
FIREBASE_STORAGE_BUCKET=replace_with_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
FIREBASE_APP_ID=replace_with_app_id
FIREBASE_MEASUREMENT_ID=replace_with_measurement_id
# Must match the exact UID authorized in firestore.rules.
CRM_COACH_UID=replace_with_coach_uid
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_rotated_key
CLOUDINARY_API_SECRET=replace_with_rotated_secret
