rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && uid == 'REPLACE_WITH_COACH_AUTH_UID';
    }
    match /users/{uid}/crm/current {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['revision','count','byteLength','format','updatedAt']) && request.resource.data.format == 1 && request.resource.data.revision is string && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 16 && request.resource.data.byteLength is int && request.resource.data.byteLength > 0 && request.resource.data.byteLength <= 6291456 && request.resource.data.updatedAt == request.time;
      match /chunks/{chunkId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['revision','payload']) && request.resource.data.revision is string && request.resource.data.payload is bytes && request.resource.data.payload.size() <= 393216;
      }
    }
  }
}
